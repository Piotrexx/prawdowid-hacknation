# Sekrety i ustawienia backendu na produkcji.
#   cp deploy/backend.env.example backend/.env && chmod 600 backend/.env
#
# NIE ustawiaj tu: DATABASE_URL, BIELIK_BASE_URL, BIELIK_MODEL, CORS_ORIGINS,
# PUBLIC_BASE_URL, FORWARDED_ALLOW_IPS – nadpisuje je docker-compose.prod.yml
# na podstawie .env (domena, hasło bazy, model).
# Pełna lista opcji z opisami: backend/.env.example.

# --- Model językowy ---
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-deepseek-api-key
LLM_JSON_MODE=json_object
LLM_TIMEOUT_S=60.0
LLM_EXTRACT_EFFORT=low
LLM_ASSESS_EFFORT=medium
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=1.20

# --- Bielik (adres i model ustawia compose) ---
BIELIK_TIMEOUT_S=120.0

# --- Google Fact Check Tools (opcjonalnie) ---
# GOOGLE_FACTCHECK_API_KEY=

# --- Bezpieczeństwo (openssl rand -hex 32) ---
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# Nie zmieniaj po starcie – zmiana unieważnia identyfikatory sesji w bazie.
ID_HASH_SALT=replace-with-openssl-rand-hex-32
RATE_LIMIT_PER_MINUTE=10
RETENTION_DAYS=30

# --- Konto moderatora ---
MODERATOR_BOOTSTRAP_EMAIL=admin@example.com
# Usuń po pierwszym logowaniu.
MODERATOR_BOOTSTRAP_PASSWORD=replace-with-strong-password
MODERATOR_BOOTSTRAP_NAME=Superużytkownik
MODERATOR_SESSION_HOURS=12
# MODERATOR_WEBHOOK_URL=

# --- Wyszukiwanie ---
EMBEDDING_BACKEND=fastembed

# --- Weryfikacja ---
MAX_CLAIMS=4
CLARIFICATION_MAX_ROUNDS=2

# --- Zdjęcia ---
# Yandex/TinEye bywają blokowane z IP AWS; wtedy ustaw pustą wartość: IMAGE_SEARCH_ENGINES=
IMAGE_SEARCH_ENGINES=yandex,tineye

# --- Ingest ---
INGEST_MAX_PER_SOURCE=10

# Musi odpowiadać PRIVACY_POLICY_VERSION w frontend/src/lib/consent.ts
PRIVACY_POLICY_VERSION=2026-11-21
