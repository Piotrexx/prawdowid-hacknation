# Bot Discord (profil "bot" w docker-compose.prod.yml).
#   cp deploy/discord-bot.env.example discord-bot/.env && chmod 600 discord-bot/.env
# API_URL i FRONTEND_URL ustawia compose.

DISCORD_TOKEN=replace-with-bot-token
CLIENT_ID=replace-with-application-id
# Z GUILD_ID komenda /fact-check pojawia się od razu na tym serwerze;
# bez niego rejestracja globalna trwa do godziny.
# GUILD_ID=
