# Zmienne dla docker-compose.prod.yml.
# Skopiuj do .env w katalogu głównym projektu i uzupełnij:
#   cp .env.production.example .env
#   chmod 600 .env
#
# Hasła generuj jako hex, żeby nie zawierały znaków psujących URL:
#   openssl rand -hex 24

# Domena publiczna (bez https://). Dla DuckDNS: nazwa.duckdns.org
DOMAIN=prawdowid.example.com
# Adres do Let's Encrypt (powiadomienia o certyfikatach).
ACME_EMAIL=admin@example.com

POSTGRES_DB=prawdowid
POSTGRES_USER=prawdowid
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# Model Bielika w Ollamie.
# Q8_0  ~5.1 GB, najlepsza jakość, mieści się na 16 GB.
# Q4_K_M ~3 GB, szybszy na CPU, używaj na 8 GB (jeśli tag jest dostępny).
BIELIK_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
