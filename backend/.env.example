# Skopiuj do .env i uzupełnij. Pliku .env nie wolno commitować.

# --- Model językowy -------------------------------------------------------
# openai_compatible | anthropic | none
LLM_PROVIDER=openai_compatible
# `deepseek-flash` to identyfikator w API; obecnie obsługuje go model DeepSeek-V4.1-Flash.
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# json_object (DeepSeek, większość serwerów) | json_schema (dostawcy ze ścisłym schematem)
LLM_JSON_MODE=json_object

# Inni dostawcy z API zgodnym z OpenAI – wystarczy zmienić trzy zmienne:
#   Mistral (UE):     LLM_BASE_URL=https://api.mistral.ai/v1    LLM_MODEL=mistral-large-latest  LLM_JSON_MODE=json_schema
#   Ollama lokalnie:  LLM_BASE_URL=http://localhost:11434/v1    LLM_MODEL=<model>               (bez klucza)
# Claude:  LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5-5  ANTHROPIC_API_KEY=...
# ANTHROPIC_API_KEY=
# Ceny (USD za 1 mln tokenów) dla modeli spoza wbudowanej tabeli – do szacowania kosztu:
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# Opis miejsca przetwarzania pokazywany użytkownikom:
# PROCESSING_LOCATION=

# --- Bezpieczeństwo i prywatność -------------------------------------------
# Token panelu moderatora. Bez niego panel jest wyłączony.
ADMIN_TOKEN=
# Losowy ciąg do skracania identyfikatorów (numery telefonów, adresy IP).
ID_HASH_SALT=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=10
RETENTION_DAYS=30

# --- Wyszukiwanie ----------------------------------------------------------
# fastembed = lokalny model wielojęzyczny (pobierany raz, ok. 220 MB) | off = tylko słowa kluczowe
EMBEDDINGS=fastembed

# --- Pętla informacji ------------------------------------------------------
CASE_LOOP_ENABLED=true
CASE_NOTIFY_THRESHOLD=2
# Webhook osoby wskazanej przez administratora (Slack lub Discord):
# MODERATOR_WEBHOOK_URL=

# --- Demonstracyjny kanał SMS ------------------------------------------------
# demo = symulator w interfejsie WWW | off
SMS_MODE=demo
# Adres frontendu – trafia do linków w odpowiedziach SMS.
PUBLIC_WEB_URL=http://localhost:3000
