# Prawdowid Backend Configuration

# --- DeepSeek (for final fake news verdict) ---
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_JSON_MODE=json_object
LLM_TIMEOUT_S=60.0

# --- Bielik 4.5B Instruct (for keyword extraction) ---
# Typically served via Ollama (http://localhost:11434) or vLLM
BIELIK_BASE_URL=http://localhost:11434/v1
BIELIK_MODEL=llama3.2:3b
BIELIK_API_KEY=  # Optional, if your Ollama/vLLM requires auth
BIELIK_TIMEOUT_S=120.0

# --- Google Fact Check Tools API ---
# Get API key from: https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key-here

# --- Security & Privacy ---
ADMIN_TOKEN=your-secure-admin-token-here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=10
RETENTION_DAYS=30
ID_HASH_SALT=change-this-to-a-secure-random-string

# --- Cost tracking (optional, per 1M tokens) ---
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=1.20