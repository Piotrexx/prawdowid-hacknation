# Prawdowid Backend Configuration

# --- DeepSeek (for final fake news verdict) ---
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_JSON_MODE=json_object
LLM_TIMEOUT_S=60.0
# Wysiłek modelu na etapie wydzielania twierdzeń i oceny dowodów
LLM_EXTRACT_EFFORT=low
LLM_ASSESS_EFFORT=medium
# LLM_PROVIDER=anthropic korzysta z tego klucza (albo ANTHROPIC_API_KEY ze środowiska)
# ANTHROPIC_API_KEY=

# --- Bielik 4.5B Instruct (for keyword extraction) ---
# Lokalny polski model, uruchamiany przez Ollamę (http://localhost:11434) albo vLLM.
# ollama pull SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
# Bielik nie ma tagu `latest`, więc kwantyzację podaje się wprost (Q8_0 ok. 5,1 GB, FP16 ok. 9,5 GB).
BIELIK_BASE_URL=http://localhost:11434/v1
BIELIK_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
BIELIK_API_KEY=  # Optional, if your Ollama/vLLM requires auth
BIELIK_TIMEOUT_S=120.0

# --- Google Fact Check Tools API ---
# Get API key from: https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key-here

# --- Wyszukiwanie w katalogu źródeł ---
# fastembed = BM25 + embeddingi (hybrydowo); off = samo BM25
EMBEDDINGS=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_TOP_K=8
# Powyżej tylu dni źródło jest oznaczane jako archiwalne
ARCHIVAL_DAYS=365

# --- Weryfikacja ---
MAX_CLAIMS=4
MAX_INPUT_CHARS=20000
RESULT_CACHE_HOURS=24

# --- Pętla informacji (kolejka moderatora) ---
CASE_LOOP_ENABLED=true
CASE_NOTIFY_THRESHOLD=2
# Webhook Slack/Discord; bez niego sprawy są widoczne tylko w panelu moderatora
# MODERATOR_WEBHOOK_URL=

# --- Security & Privacy ---
ADMIN_TOKEN=your-secure-admin-token-here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=10
RETENTION_DAYS=30
ID_HASH_SALT=change-this-to-a-secure-random-string
# Wersja polityki prywatności, na którą zbierana jest zgoda.
# Musi odpowiadać PRIVACY_POLICY_VERSION w frontend/src/lib/consent.ts
PRIVACY_POLICY_VERSION=2026-11-21
URL_FETCH_TIMEOUT_S=10.0
URL_FETCH_MAX_BYTES=2000000
IMAGE_MAX_BYTES=5000000

# --- Cost tracking (optional, per 1M tokens) ---
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=1.20

# --- Baza i dane ---
# SQLAlchemy URL; SQLite domyślnie, Postgres np. postgresql+psycopg://user:pass@host/db
# DATABASE_URL=
