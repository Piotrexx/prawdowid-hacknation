# Prawdowid Backend Configuration

# --- Model językowy (wymienny dostawca) ---
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_JSON_MODE=json_object
LLM_TIMEOUT_S=60.0
# Wysiłek modelu na etapie wydzielania twierdzeń i oceny dowodów
LLM_EXTRACT_EFFORT=low
LLM_ASSESS_EFFORT=medium
# LLM_PROVIDER=anthropic korzysta z tego klucza (albo ANTHROPIC_API_KEY ze środowiska)
# ANTHROPIC_API_KEY=

# --- Bielik 4.5B Instruct (słowa kluczowe, lokalnie) ---
# ollama pull SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
BIELIK_BASE_URL=http://localhost:11434/v1
BIELIK_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
BIELIK_API_KEY=
BIELIK_TIMEOUT_S=120.0

# --- Google Fact Check Tools API ---
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key-here

# --- Baza danych (PostgreSQL + pgvector) ---
# Lokalnie: docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://prawdowid:prawdowid@localhost:5432/prawdowid

# --- Wyszukiwanie semantyczne ---
# fastembed = embeddingi + pgvector; none = tylko wyszukiwanie leksykalne
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# EMBEDDING_CACHE_DIR=
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
RETRIEVAL_MIN_SIMILARITY=0.58
RETRIEVAL_STRONG_SIMILARITY=0.82
RETRIEVAL_MAX_PER_SOURCE=2
# Powyżej tylu dni źródło jest oznaczane jako archiwalne (nie jest ukrywane)
ARCHIVAL_DAYS=365

# --- Weryfikacja ---
MAX_CLAIMS=4
MAX_INPUT_CHARS=20000
RESULT_CACHE_HOURS=24

# --- Ingest źródeł ---
INGEST_MAX_PER_SOURCE=10
INGEST_TIMEOUT_S=20.0
INGEST_REQUEST_DELAY_S=1.0
# INGEST_CACHE_DIR=/app/var/ingest

# --- Multimodalność ---
IMAGE_MAX_BYTES=5000000
AUDIO_MAX_BYTES=10000000
AUDIO_MAX_SECONDS=120
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_CACHE_DIR=/app/var/whisper

# --- Pętla informacji (kolejka moderatora) ---
CASE_LOOP_ENABLED=true
CASE_NOTIFY_THRESHOLD=2
# Webhook Slack/Discord; bez niego sprawy są widoczne tylko w panelu moderatora
# MODERATOR_WEBHOOK_URL=

# --- Kontrolowana archiwizacja ---
ARCHIVE_ENABLED=true
ARCHIVE_MAX_CHARS=2000
ARCHIVE_RETENTION_DAYS=30

# --- Security & Privacy ---
ADMIN_TOKEN=your-secure-admin-token-here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=10
RETENTION_DAYS=30
ID_HASH_SALT=change-this-to-a-secure-random-string
# Wersja polityki prywatności, na którą zbierana jest zgoda.
# Musi odpowiadać PRIVACY_POLICY_VERSION w frontend/src/lib/consent.ts
PRIVACY_POLICY_VERSION=2026-11-21
URL_FETCH_TIMEOUT_S=10.0
URL_FETCH_MAX_BYTES=2000000

# --- Cost tracking (optional, per 1M tokens) ---
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=1.20

# --- Weryfikacja zdjęć (odwrotne wyszukiwanie, bez kluczy API) ---
# Silniki: yandex, tineye, bing (bing nie działa w PicImageSearch 3.12.11, dlatego domyślnie wyłączony)
IMAGE_SEARCH_ENGINES=yandex,tineye
IMAGE_SEARCH_TIMEOUT_S=25
IMAGE_CACHE_HOURS=24
